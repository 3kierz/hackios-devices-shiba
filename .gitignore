# What devices/shiba/pull-boot-info.sh pulls from the phone stays out: its properties, device tree and memory map carry
# the phone's own identifiers (serial, SoC id). The first-boot logs read back from pstore are kept.
boot-info/*
!boot-info/first-boot-*.txt
__pycache__/
# every private working note (handoff, todo lists, plans, crash catalogue): never in git
private-untracked/
# this phone's own device tree (pull-boot-info.sh, then copied): it carries the phone's identifiers, kept local
prebuilt/device-tree.dtb
# what tools/backup.py copies off the phone (its identity among it) and carve.py makes from it: never in git
backups/
