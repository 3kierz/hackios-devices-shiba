/*
 * HakiOS's U-Boot on the Pixel 8 (shiba). Upstream U-Boot's generic Exynos phone board (board/samsung/exynos-mobile),
 * HakiOS's hakios command (cmd/hakios.c) and the zuma pieces of devices/shiba (hakios_zuma.c, zuma.patch). No keys, no
 * USB and no storage in U-Boot on zuma yet: nothing to choose with, so it boots straight through. The loader and its
 * payload come from the HKUB container the boot image carries behind U-Boot (hakios load); the screen is the output.
 * When anything fails, what is in memory stays on the screen for a minute and the phone restarts, into Android.
 */
bootdelay=0
stdin=nulldev
stdout=vidconsole
stderr=vidconsole

/*
 * The console kept over the restart (hakios_zuma.c, the device "pstore"): appended to Google's bootloader's own log
 * buffer (bldr_log_reserved@fd800000: +0 the length, +8 the room, the text from +0x10; read on the phone), which survives
 * a restart; the next bootloader reports it in Android's /sys/fs/pstore/console-ramoops-0 (devices/shiba/pull-log.sh).
 * Android's ramoops zones ($hakios_pstore) do not survive any restart on the Pixel 8, so none is set.
 */
hakios_bldrlog=0xfd800000

/*
 * The panel (google-shoreline) runs in DSI command mode: it shows a frame only when DECON0 sends one, and Google's
 * bootloader leaves DECON0's TRIG_CON (0x19470030) masked after its splash: 0x3070, so nothing U-Boot draws would reach
 * the panel. 0x3061 unmasks the hardware trigger, and the panel is refreshed from the splash buffer (0xfac00000) at every
 * TE again. The value and the write are those found on the Pixel 8a, 8 Pro and 7 Pro (the same DECON at the same address,
 * the same bootloader family). Only that exact masked value is changed: anything else is left alone, and said.
 */
preboot=setenv stdout vidconsole,pstore; setenv stderr vidconsole,pstore; \
	if itest.l *0x19470030 == 0x3070; then mw.l 0x19470030 0x3061; echo "[oosexgang] display: DECON0 trigger unmasked"; \
	else echo "[oosexgang] display: DECON0 TRIG_CON is not 0x3070, left as it is:"; md.l 0x19470030 1; fi; \
	zuma wdt; zuma touch; zuma panel; \
	if test "${hakios_ufs}" != 0; then scsi scan; fi; \
	if test -n "${hakios_probe}"; then run hakios_probe; fi

/*
 * The touch screen powered for the kernel's driver (hakios_zuma.c, zuma touch): the reset pin low, AVDD (S2MPG14 LDO4M)
 * at the 3.3 V of the Pixel 8's tree and on, DVDD (LDO25M) on, through ACPM; then the reset pin high.
 */
/*
 * The phone's storage (hakios_zuma_ufs.c): brought up from cold and scanned at every boot, read only, so that the
 * loader finds its logical units and partitions through UEFI's BlockIo and PartitionInfo (ufs=1: its survey; ufs=2: the
 * kernel reads through it, drivers/storage/hakios.ufs.c). HS-G4 unless hakios_ufs_hs=0; hakios_ufs=0 leaves it off.
 * U-Boot refuses every write (the loader's log into klog among them).
 */
hakios_ufs=1

/* a test's commands, run last in preboot: empty in a normal build */
hakios_probe=

/*
 * The watchdogs of the two CPU clusters (watchdog_cl0@10060000, watchdog_cl1@10070000 in the phone's tree). Google's
 * bootloader leaves them counting for Linux, which nothing here feeds: the Pixel 8a restarted about two minutes after
 * every hand-over. `zuma wdt` shows both and stops them; cl0 is then set going again as slowly as it counts, a net for a
 * hang (about 2.5 minutes on the 8a), which the loader and the kernel feed (xnuloader/loader.c wdt_samsung).
 */
hakios_wdt=0x10060000 0x10070000
hakios_wdt_net=0x10060000

/*
 * Google's bootloader hands over with the instruction cache off (on the 8a: `hakios load` took 1 min 45 s with it off,
 * 0.24 s on). From the loader on the console goes to pstore only (the kernel draws its own screen; drawing the kernel's
 * log line by line took minutes): hakios_screen=1 keeps the screen too.
 */
/* the screen kept as the console too, until pstore has been seen to survive a run on the Pixel 8 (first run, 2026-11-22:
 * U-Boot drew, the loader started, the screen went black and pmsg-ramoops-0 came back empty) */
hakios_screen=1
bootcmd=icache on; dcache on; if time hakios load; then if test "${hakios_screen}" != 1; then \
	echo "[oosexgang] hakios: from the loader on, the console goes to pstore only (console-ramoops-0)"; \
	setenv stdout pstore; setenv stderr pstore; fi; hakios boot; setenv stdout vidconsole,pstore; \
	setenv stderr vidconsole,pstore; fi; run hakios_failed
/* (2026-11-23: no reset of its own -- a software reset, and the loader's watchdog, left the bootloader keeping none of
 * the log; the power button's reset keeps it) */
hakios_failed=echo; echo "HakiOS: the loader did not start (above); what is in memory:"; hakios info; zuma pstore; \
	echo "HakiOS: hold the power button to restart -- the log is kept (devices/shiba/pull-log.sh in Android)"; \
	while true; do sleep 3600; done
